<Window x:Class="TheMovies.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TheMovies"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">


    <!--Cop/paste for comment -->
    <!-- -->

    <Grid Margin="30">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Grids for scenario 1 -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                
            </Grid.RowDefinitions>


            <!-- Heading -->
            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Foreground="DarkRed" Text="★THE MOVIES★" FontSize="40" FontWeight="Heavy" FontFamily="Verdana" HorizontalAlignment="Center" Margin="20"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- First two buttons -->
                <Button Content="OPRET FILM" Command="{Binding MakeMovieCommand}" Width="140" Height="30" FontFamily="Times New Roman"  Margin="10" />
                <Button Content="OPRET SCREENING" Command="{Binding MakeScreeningCommand}" Width="140" Height="30" FontFamily="Times New Roman" Margin="10"/>

            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- Next two buttons-->
                <Button Content="Se film liste" Width="140" Height="30" FontFamily="Times New Roman" Margin="10" />
                <Button Content="Månedens screenings" Width="140" Height="30" FontFamily="Times New Roman" Margin="10"/>

            </StackPanel>
        </Grid>

    </Grid>
</Window>
