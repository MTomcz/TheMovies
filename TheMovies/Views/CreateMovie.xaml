<Page x:Class="TheMovies.Views.CreateMovie"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TheMovies.Views"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="800"
      Title="CreateMovie">

    <Grid>

        

        <Grid Margin="30">
            
            
            <Grid.RowDefinitions>
                <!-- Grids for scenario 1 -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="30"/>

                <!-- Grids for scenario 2 -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- Heading -->
            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Foreground="DarkRed" Text="★OPRET FILM★" FontSize="40" FontWeight="Heavy" FontFamily="Verdana" HorizontalAlignment="Center" Margin="20"/>


            <!-- Title -->
            <TextBlock Grid.Row="1" Text="Titel:" FontSize="20"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Movie.Title}" Margin="2"/>


            <!-- Duration -->
            <TextBlock Grid.Row="2" Text="Varighed(min):" FontSize="20"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Movie.Duration}" Margin="2"/>


            <!-- Genre -->
            <TextBlock Grid.Row="3" Text="Genre:" FontSize="20"/>
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Movie.Genre}" Margin="2"/>


            <!-- Director -->
            <TextBlock Grid.Row="5" Text="Instruktør:" FontSize="20"/>
            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Movie.Director}" Margin="2" />

            <!-- Primeredate -->
            <TextBlock Grid.Row="6" Text="Primæredato:" FontSize="20"/>
            <DatePicker Grid.Row="6" Grid.Column="1" HorizontalAlignment="Left" SelectedDate="{Binding Movie.Premierdate}" Margin="2"/>


            <!-- button "gem film" -->
            <Button Grid.Row="8" Grid.ColumnSpan="2" Content="Gem film" Width="120" Command="{Binding SaveMovieCommand}"/>

            <Button Grid.Row="10" Grid.ColumnSpan="2" HorizontalAlignment="Left" Content="🡠 Tilbage" Width="120" Command="{Binding GoBackMovieCommand}"/>

        </Grid>

    </Grid>
</Page>
