<Page x:Class="TheMovies.Views.ScreeningList"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TheMovies.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ScreeningList">

    <Grid>

        <Grid Margin="30">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Heading -->
            <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Foreground="DarkRed" Text="★SCREENING LISTE★" FontSize="40" FontWeight="Heavy" FontFamily="Verdana" HorizontalAlignment="Center" Margin="20"/>

            <!-- Hjerm -->
            <StackPanel Grid.Column="0" Grid.Row="1">
                
                <TextBlock Text="HJERM" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" Margin="5"/>
               
                <!-- Listbox of Screening for Hjerm -->
                <ListBox  ItemsSource="{Binding HjermScreenings}" Height="210" Margin="5" >

                    <ListBox.ItemTemplate>
                        <DataTemplate>

                            <Border BorderThickness="1" Margin="2">

                                <StackPanel>

                                    <TextBlock Text="{Binding Movie.Title}" FontSize="20" FontWeight="DemiBold"/>
                                    <TextBlock Text="{Binding Showtime, StringFormat={}{0:dd/MM/yyyy HH:mm}}"/>
                                    <TextBlock Text="{Binding AdStart, StringFormat=Movie starts:{0:HH:mm}}" />
                                    <TextBlock Text="{Binding MovieEnd, StringFormat=Movie ends: {0:HH:mm}}"/>
                                    <TextBlock Text="{Binding CleaningEnd, StringFormat=Cleaning ends: {0:HH:mm}}"/>


                                </StackPanel>

                            </Border>

                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>


            </StackPanel>


            <!-- Videbæk -->
            <StackPanel Grid.Column="1" Grid.Row="1">
                
                <TextBlock Text="VIDEBÆK" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" Margin="5"/>

                <!-- Listbox of Screening for Videbæk -->
                <ListBox ItemsSource="{Binding VidebækScreenings}" Height="210" Margin="5" >

                    <ListBox.ItemTemplate>
                        <DataTemplate>

                            <Border BorderThickness="1" Margin="2">

                                <StackPanel>

                                    <TextBlock Text="{Binding Movie.Title}" FontSize="20" FontWeight="DemiBold"/>
                                    <TextBlock Text="{Binding Showtime, StringFormat={}{0:dd/MM/yyyy HH:mm}}"/>
                                    <TextBlock Text="{Binding AdStart, StringFormat=Movie starts:{0:HH:mm}}" />
                                    <TextBlock Text="{Binding MovieEnd, StringFormat=Movie ends: {0:HH:mm}}"/>
                                    <TextBlock Text="{Binding CleaningEnd, StringFormat=Cleaning ends: {0:HH:mm}}"/>


                                </StackPanel>

                            </Border>

                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>



            </StackPanel>


            <!-- Thorsminde -->
            <StackPanel Grid.Column="2" Grid.Row="1">
                
                <TextBlock Text="THORSMINDE" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" Margin="5"/>

                <!-- Listbox of Screening for Thorsminde -->
                <ListBox ItemsSource="{Binding ThorsmindeScreenings}" Height="210" Margin="5" >

                    <ListBox.ItemTemplate>
                        <DataTemplate>

                            <Border BorderThickness="1" Margin="2">

                                <StackPanel>

                                    <TextBlock Text="{Binding Movie.Title}" FontSize="20" FontWeight="DemiBold"/>
                                    <TextBlock Text="{Binding Showtime, StringFormat={}{0:dd/MM/yyyy HH:mm}}"/>
                                    <TextBlock Text="{Binding AdStart, StringFormat=Movie starts:{0:HH:mm}}" />
                                    <TextBlock Text="{Binding MovieEnd, StringFormat=Movie ends: {0:HH:mm}}"/>
                                    <TextBlock Text="{Binding CleaningEnd, StringFormat=Cleaning ends: {0:HH:mm}}"/>


                                </StackPanel>

                            </Border>

                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>


            </StackPanel>


            <!-- Ræhr -->
            
            <StackPanel Grid.Column="3" Grid.Row="1">
                <TextBlock Text="RÆHR" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" Margin="5"/>

                <!-- Listbox of Screening for Ræhr -->
                <ListBox ItemsSource="{Binding RæhrScreenings}" Height="210" Margin="5" >

                    <ListBox.ItemTemplate>
                        <DataTemplate>

                            <Border BorderThickness="1" Margin="2">

                                <StackPanel>

                                    <TextBlock Text="{Binding Movie.Title}" FontSize="20" FontWeight="DemiBold"/>
                                    <TextBlock Text="{Binding Showtime, StringFormat={}{0:dd/MM/yyyy HH:mm}}"/>
                                    <TextBlock Text="{Binding AdStart, StringFormat=Movie starts:{0:HH:mm}}" />
                                    <TextBlock Text="{Binding MovieEnd, StringFormat=Movie ends: {0:HH:mm}}"/>
                                    <TextBlock Text="{Binding CleaningEnd, StringFormat=Cleaning ends: {0:HH:mm}}"/>


                                </StackPanel>

                            </Border>

                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>


            </StackPanel>

            
            <!-- Back button -->
            <Button Grid.Row="5" HorizontalAlignment="Left" Content="🡠 Tilbage" Width="120" Command="{Binding GoBackMovieCommand}" Margin="2"/>


        </Grid>
        
    </Grid>
</Page>
